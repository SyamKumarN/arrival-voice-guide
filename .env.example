# Copy this file to .env and fill in only what you want. Everything is optional.
# Never commit .env.

# Natural voice for Hindi / Telugu / English replies (Sarvam text-to-speech)
SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_SPEAKER=anushka

# Free-form questions the rules can't answer (Claude)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Live rates source (free, no key). Leave as is unless you want another source.
# RATES_URL=https://open.er-api.com/v6/latest/USD

# PORT=8080
