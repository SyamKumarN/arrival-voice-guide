# Copy this file to .env and fill in only what you want. Everything is optional.
# Never commit .env.

# Natural voice for Hindi / Telugu / English replies (Sarvam text-to-speech)
SARVAM_API_KEY=
# SARVAM_TTS_MODEL=bulbul:v2
# SARVAM_SPEAKER=anushka

# AI understanding: only when the built-in rules don't understand a sentence.
# The AI only picks from the app's fixed list (intent, airport, terminal, amounts, currency);
# answers always come from the app's own data. 3-second limit, rate limited, nothing logged.
AI_API_KEY=
# AI_MODEL=claude-haiku-5-5   (default; fast enough for the 3-second limit)

# Live rates source (free, no key). Leave as is unless you want another source.
# RATES_URL=https://open.er-api.com/v6/latest/USD

# PORT=8080
