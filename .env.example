# Copy this file to .env and fill in only what you want. Everything is optional:
# with every value left empty, the app runs fully on its built-in rules and data.
# Never commit .env. For the live site, set these as Vercel environment variables.

# --- AI understanding (Anthropic API key) ---
# Every sentence goes to the AI first, with the conversation so far. It only fills in the
# app's fixed form (intent, airport, terminal, amounts, currency); answers come from the
# app's own data. Out-of-scope questions may get one short, server-checked sentence.
# No reply within 4 seconds, offline, or empty: the rules answer. Rate limited; nothing logged.
AI_API_KEY=
# Model for AI understanding. Empty = claude-haiku-5-5 (fast enough for the 4-second limit).
AI_MODEL=

# --- Natural voice (Sarvam text-to-speech) ---
# Empty = the phone's own voice.
SARVAM_API_KEY=
# Empty = bulbul:v2
SARVAM_TTS_MODEL=
# Empty = anushka
SARVAM_SPEAKER=

# --- Rates ---
# Live mid-market rates source (free, no key). Empty = https://open.er-api.com/v6/latest/USD
RATES_URL=

# --- Server ---
# Port for the Docker / npm start server. Empty = 8080
PORT=
